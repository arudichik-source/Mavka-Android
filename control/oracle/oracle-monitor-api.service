[Unit]
Description=Oracle VM read-only MaVka WEB telemetry
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/oracle-monitor
EnvironmentFile=/home/ubuntu/oracle-monitor/private.env
ExecStart=/usr/bin/python3 /home/ubuntu/oracle-monitor/monitor_api.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=96M
CPUQuota=10%
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
