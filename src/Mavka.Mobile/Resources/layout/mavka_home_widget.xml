<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/mavka_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="МАВКА  ·  ШВИДКИЙ ДОСТУП"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/widget_library" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="▤\nБібліотека"
            android:textSize="13sp" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/widget_notices" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="♢\nСповіщення"
            android:textSize="13sp" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/widget_assets" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="▣\nМайно"
            android:textSize="13sp" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/widget_inbox" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="✉\nПошта"
            android:textSize="13sp" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
