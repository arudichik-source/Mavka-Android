<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../DependencyVersions.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>

    <ApplicationId>ua.mavka.mobile</ApplicationId>
    <ApplicationTitle>Mavka Mobile</ApplicationTitle>
    <!-- Monotonically increasing Android versionCode for in-place upgrades.
         The installed APK must also have the same signing certificate. -->
    <ApplicationVersion>2026102303</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.2</ApplicationDisplayVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>35</TargetSdkVersion>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

<PropertyGroup Condition="'$(ApplicationId)' == 'ua.mavka.mobile.relayqa'">
    <DefineConstants>$(DefineConstants);MAVKA_RELAY_QA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ApplicationId)' == 'ua.mavka.mobile.registrationqa'">
    <DefineConstants>$(DefineConstants);MAVKA_BOOTSTRAP_QA</DefineConstants>
  </PropertyGroup>

<ItemGroup>
  <PackageReference Include="MailKit" Version="$(MavkaMailKitVersion)" />
  <PackageReference Include="OpenMcdf" Version="$(MavkaOpenMcdfVersion)" />
  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="$(MavkaPkcsVersion)" />
  <PackageReference Include="PDFsharp" Version="6.2.4" />
  <PackageReference Include="ExcelEncryptor" Version="2.0.5.1" />
  <PackageReference Include="ZXing.Net" Version="0.16.11" />
</ItemGroup>

</Project>
